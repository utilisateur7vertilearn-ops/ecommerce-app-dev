@page "/products"
@using ECommerce.Web.Services
@inject CatalogApiClient Catalog
@inject OrderingApiClient Ordering
@inject PromotionsApiClient Promotions
@rendermode InteractiveServer

<PageTitle>Catalog</PageTitle>

<h1>Catalog</h1>

@if (_products is null)
{
    <p><em>Loading products…</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Description</th>
                <th class="text-end">Price</th>
                <th class="text-end">Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _products)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td class="text-end">@p.Price.ToString("C")</td>
                    <td class="text-end">@p.AvailableStock</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddToCart(p)">Add</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Cart</h2>
    @if (_cart.Count == 0)
    {
        <p><em>Your cart is empty.</em></p>
    }
    else
    {
        <ul>
            @foreach (var line in _cart)
            {
                <li>@line.Value × @line.Key.Name (@line.Key.Price.ToString("C"))</li>
            }
        </ul>

        <p>
            Subtotal: @Subtotal.ToString("C")
            @if (_discountedTotal is not null)
            {
                <strong class="text-success"> → @_discountedTotal.Value.ToString("C") (code @_appliedCode)</strong>
            }
        </p>

        <div class="mb-2 d-flex align-items-end gap-2">
            <div>
                <label class="form-label">Promo code</label>
                <input class="form-control" style="max-width: 200px" @bind="_promoCode" />
            </div>
            <button class="btn btn-outline-secondary" @onclick="ApplyPromoCode" disabled="@_applyingPromo">Apply</button>
        </div>
        @if (!string.IsNullOrEmpty(_promoMessage))
        {
            <div class="alert @(_promoIsError ? "alert-danger" : "alert-success") mt-2">@_promoMessage</div>
        }

        <div class="mb-2 mt-3">
            <label class="form-label">Customer name</label>
            <input class="form-control" style="max-width: 320px" @bind="_customer" />
        </div>
        <button class="btn btn-primary" @onclick="PlaceOrder" disabled="@_placing">Place order</button>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_message</div>
    }
}

@code {
    private static readonly Dictionary<string, string> PromoReasonMessages = new()
    {
        ["unknown_code"] = "Code promo inconnu.",
        ["not_started"] = "Ce code n'est pas encore actif.",
        ["expired"] = "Ce code a expiré.",
        ["exhausted"] = "Ce code a atteint sa limite d'utilisation.",
        ["amount_too_low"] = "Le montant du panier est insuffisant pour ce code.",
    };

    private IReadOnlyList<ProductDto>? _products;
    private readonly Dictionary<ProductDto, int> _cart = new();
    private string _customer = "";
    private bool _placing;
    private string? _message;
    private bool _isError;

    private string _promoCode = "";
    private bool _applyingPromo;
    private string? _promoMessage;
    private bool _promoIsError;
    private decimal? _discountedTotal;
    private string? _appliedCode;

    private decimal Subtotal => _cart.Sum(c => c.Key.Price * c.Value);

    protected override async Task OnInitializedAsync()
    {
        _products = await Catalog.GetProductsAsync();
    }

    private void AddToCart(ProductDto product)
    {
        _cart[product] = _cart.TryGetValue(product, out var qty) ? qty + 1 : 1;
        _message = null;
        _discountedTotal = null;
        _appliedCode = null;
    }

    private async Task ApplyPromoCode()
    {
        if (string.IsNullOrWhiteSpace(_promoCode))
        {
            _promoMessage = "Entrez un code promo.";
            _promoIsError = true;
            return;
        }

        _applyingPromo = true;
        var result = await Promotions.ValidateAsync(_promoCode, Subtotal);
        _applyingPromo = false;

        if (result.Valid && result.DiscountedAmount is not null)
        {
            _discountedTotal = result.DiscountedAmount;
            _appliedCode = _promoCode.Trim().ToUpperInvariant();
            _promoMessage = "Code promo appliqué !";
            _promoIsError = false;
        }
        else
        {
            _discountedTotal = null;
            _appliedCode = null;
            _promoMessage = PromoReasonMessages.GetValueOrDefault(result.Reason ?? "", "Ce code promo n'est pas valide.");
            _promoIsError = true;
        }
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(_customer))
        {
            _message = "Please enter a customer name.";
            _isError = true;
            return;
        }

        _placing = true;
        var order = new CreateOrderDto(
            _customer,
            _cart.Select(c => new OrderLineDto(c.Key.Id, c.Value)).ToList());

        var (success, error) = await Ordering.CreateOrderAsync(order);
        _placing = false;

        if (success)
        {
            _message = "Order placed successfully!";
            _isError = false;
            _cart.Clear();
            _customer = "";
        }
        else
        {
            _message = $"Failed to place order: {error}";
            _isError = true;
        }
    }
}
